{
  "note": "Second test set, written after the first set and never used to tune the app's code or instructions. All data is made up: different household, different pantries, different wording and products from parse.json and rerank.json. The answer key for every parse case (the 'expect', 'oov', 'flexQty', price and total fields) was written by hand before any model call. The rerank answer key ('answerKey.rerank') is the app's own rule-based engine output (no AI), frozen before any model call. Field meanings are the same as parse.json and rerank.json.",
  "parse": {
    "items": [
      {"id": "n01", "source": "manual", "text": "Sunfield chakki atta 10 kg, maida 1 kg, sugar 2kg", "expect": [["atta", 10000], ["sugar", 2000]], "oov": ["maida"], "hard": "brand name in front of the item; maida (refined flour) is a different flour and must not become atta"},
      {"id": "n02", "source": "voice", "text": "dhai sau gram adrak aur aadha litre doodh", "expect": [["ginger", 250], ["milk", 500]], "hard": "'dhai sau' (two and a half hundred) is not in the instructions' list of number words"},
      {"id": "n03", "source": "voice", "text": "char sau gram paneer, ek dozen ande", "expect": [["paneer", 400], ["egg", 12]], "hard": "a dozen; plural 'ande'"},
      {"id": "n04", "source": "manual", "text": "butter 100 g, ghee 1 litre, curd 1 kg", "expect": [["ghee", 1000], ["curd", 1000]], "oov": ["butter"], "hard": "ghee's alias list contains 'clarified butter'; plain butter must not be matched to ghee"},
      {"id": "n05", "source": "voice", "text": "shakarkandi aadha kilo, aloo do kilo", "expect": [["potato", 2000]], "oov": ["shakarkandi"], "hard": "sweet potato is not potato"},
      {"id": "n06", "source": "manual", "text": "प्याज़ २ किलो, टमाटर १ किलो, आलू ३ किलो", "expect": [["onion", 2000], ["tomato", 1000], ["potato", 3000]], "hard": "Devanagari digits, and a nukta spelling of onion that differs from the dictionary alias"},
      {"id": "n07", "source": "manual", "text": "onion 1 kg\ntomato 500 g\nonion 500 g more", "expect": [["onion", 1500], ["tomato", 500]], "hard": "the same item twice; scored on the total across lines"},
      {"id": "n08", "source": "voice", "text": "tamaatar ek kilo, bhindee aadha kilo, kothmeer do gaddi", "expect": [["tomato", 1000], ["bhindi", 500], ["dhaniya", 2]], "hard": "speech-to-text misspellings; 'gaddi' means bunch"},
      {"id": "n09", "source": "manual", "text": "1.5 kg rice, 750 gm moong dal, 250gms chana dal", "expect": [["rice", 1500], ["moong-dal", 750], ["chana-dal", 250]], "hard": "decimal kilos and the unit spellings 'gm' and 'gms'"},
      {"id": "n10", "source": "manual", "text": "detergent 1 kg, agarbatti 1 pack, 2 kg besan, matchbox 10", "expect": [["besan", 2000]], "oov": ["detergent", "agarbatti", "matchbox"], "hard": "three non-food items around one food item"},
      {"id": "n11", "source": "voice", "text": "paav kilo hari mirch, das nimbu", "expect": [["green-chilli", 250], ["lemon", 10]], "hard": "'paav' spelling of pav; 'das' (ten) is not in the instructions' list of number words"},
      {"id": "n12", "source": "manual", "text": "2 packets poha, 1 packet kasuri methi", "expect": [["poha", null], ["kasuri-methi", null]], "flexQty": ["poha", "kasuri-methi"], "maxConfidence": 0.6, "hard": "two packs with no weight; both must be flagged with low confidence"},
      {"id": "n13", "source": "manual", "text": "kanda 1 kilo, batata 2 kilo, kothimbir 1 judi", "expect": [["onion", 1000], ["potato", 2000], ["dhaniya", 1]], "hard": "Marathi words; 'kothimbir' (coriander) and 'judi' (bunch) are not in the dictionary"},
      {"id": "n14", "source": "manual", "text": "mushrooms 200 g, coconut 1, capsicum 250 g, rajma 1 kg", "expect": [["capsicum", 250], ["rajma", 1000]], "oov": ["mushroom", "coconut"], "hard": "two food items that are not in the dictionary"},
      {"id": "n15", "source": "voice", "text": "teen sau gram jeera aur sau gram rai, haldi pachaas gram", "expect": [["jeera", 300], ["mustard-seed", 100], ["turmeric", 50]], "hard": "hundreds spoken as words; 'pachaas' (fifty) is not in the instructions' list"},
      {"id": "n16", "source": "manual", "text": "दूध 2 लीटर, दही 500 ग्राम, अंडे 12", "expect": [["milk", 2000], ["curd", 500], ["egg", 12]], "hard": "Devanagari units; plural 'अंडे' differs from the alias 'अंडा'"},
      {"id": "n17", "source": "list-photo", "image": "new-list-hand.png", "style": "hand", "lines": ["groceries", "palak 500 g", "baingan 1 kg", "garlic 200 g", "matar 1 kg"], "expect": [["palak", 500], ["baingan", 1000], ["garlic", 200], ["peas", 1000]], "hard": "handwriting-style font on lined paper, tilted"},
      {"id": "n18", "source": "list-photo", "image": "new-list-hinglish.png", "style": "hand", "lines": ["saaman", "chawal 5 kilo", "tuvar dal 2 kg", "ghee 1 ltr"], "expect": [["rice", 5000], ["toor-dal", 2000], ["ghee", 1000]], "hard": "handwriting-style Hinglish list"},
      {"id": "n19", "source": "list-photo", "image": "new-list-noqty.png", "style": "hand", "lines": ["to buy", "gobi", "nimbu", "bhindi 500 g"], "expect": [["cauliflower", null], ["lemon", null], ["bhindi", 500]], "flexQty": ["cauliflower", "lemon"], "maxConfidence": 0.6, "hard": "two items with no amount; both must get low confidence"},
      {"id": "n20", "source": "bill", "image": "new-bill.png", "style": "bill", "lines": ["FRESHCART MART (fictional)", "Bill No 20931", "Toor dal 2 kg  2 x 140.00   280.00", "Paneer 400 g              168.00", "Tomato 1 kg                40.50", "Discount                  -20.00", "GST                         8.50", "Handling fee               15.00", "TOTAL           Rs        492.00"], "expect": [["toor-dal", 2000], ["paneer", 400], ["tomato", 1000]], "oov": ["discount", "gst", "handling"], "expectPricePaise": {"toor-dal": 28000, "paneer": 16800, "tomato": 4050}, "expectTotalPaise": 49200, "hard": "quantity times rate (the line price is the 280.00 line total), a discount, tax and a fee that must not become items"}
    ]
  },
