      {"id": "n-r09", "mood": null, "baseStaples": false, "pantry": [["salt", 400, "counter", 1], ["oil", 300, "counter", 1], ["onion", 150, "counter", 1], ["lemon", 2, "fridge", 1]], "hard": "almost empty kitchen: no dish can be cooked now"},
