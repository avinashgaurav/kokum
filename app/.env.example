# Household sharing is optional. Without these, Kokum runs entirely on-device and every
# feature except multi-phone sync works exactly the same.
#
# Copy to app/.env and fill in from your Supabase project settings.
# The anon key is meant to be public: row-level security in supabase/migrations/0001_init.sql
# is what protects the data, not the secrecy of this key.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
