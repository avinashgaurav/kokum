{
  "expo": {
    "name": "Kokum",
    "slug": "kokum",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "kokum",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./src/assets/icon.png",
    "splash": {
      "image": "./src/assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4F8F7"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.kokum.app",
      "infoPlist": {
        "LSApplicationQueriesSchemes": ["zepto", "grofers", "blinkit", "swiggy", "zomato"]
      }
    },
    "android": {
      "package": "dev.kokum.app",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/icon-foreground.png",
        "backgroundColor": "#F4F8F7"
      }
    },
    "web": {
      "bundler": "metro"
    }
  }
}
